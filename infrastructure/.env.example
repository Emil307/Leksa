# Generated by infrastructure/scripts/setup-ports.sh — do not edit the generated .env by hand.
# Every port is derived from REPO_INDEX so parallel repo instances never collide.

REPO_INDEX=0
COMPOSE_PROJECT_NAME=uwords-0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_EXTERNAL_HOST=localhost

JWT_SECRET=replace-me-with-32-random-hex-bytes

DB_HOST=localhost
DB_PORT=5432
DB_NAME=uwords
DB_USER=uwords
DB_PASSWORD=uwords

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=uwords

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SENDER=no-reply@uwords.local
MAIL_TIMEOUT_MILLIS=60000
MAILHOG_HTTP_PORT=8025
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_CHALLENGE_MAX_ATTEMPTS=5
AUTH_CHALLENGE_REPLAY_WINDOW_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=31536000
JWT_SECRET=local-development-only-secret
