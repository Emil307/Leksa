# Debug
DEBUG=true
TIMEZONE_STR=Europe/Moscow

# Bot
# Local host ports are generated separately in infrastructure/.env and override
# BOT_PORT when the lifecycle scripts run.
BOT_TOKEN=your-bot-token-here
BOT_LINK=https://t.me/your_bot
BOT_ADMIN_CHAT_ID=0
BOT_SECRET_TOKEN=your-secret-token
BOT_WEBHOOK_URL=https://your-domain.com
BOT_HOST=0.0.0.0
BOT_PORT=8001
BOT_WORKERS=1
BOT_NAME=Uwords Bot

# Database
DB_NAME=uwords
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DECODE_RESPONSES=true

# CORS
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
